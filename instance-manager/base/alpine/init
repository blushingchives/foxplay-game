#!/bin/sh
# Minimal init for a generic Alpine instance. The kernel `ip=` boot arg
# assigns eth0 an address early, but that doesn't reliably persist into the
# running system, so we re-assert it here from the kernel command line.
set -x

mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts

ip link set lo up

# Configure eth0 from the ip= kernel arg:
#   ip=<client>:<server>:<gw>:<netmask>:<host>:<device>:<autoconf>
# The subnet is always /24 (see instance-manager network config).
iparg=""
for tok in $(cat /proc/cmdline); do
    case "$tok" in ip=*) iparg="${tok#ip=}" ;; esac
done
client=$(echo "$iparg" | cut -d: -f1)
gw=$(echo "$iparg" | cut -d: -f3)
dev=$(echo "$iparg" | cut -d: -f6)
[ -n "$dev" ] || dev=eth0

ip link set "$dev" up
[ -n "$client" ] && ip addr add "$client/24" dev "$dev" 2>/dev/null
[ -n "$gw" ] && ip route add default via "$gw" 2>/dev/null

# show the resulting network state in the console log
ip addr show
ip route show

# host keys — generated once, then persisted on the writable disk
mkdir -p /etc/dropbear
for t in rsa ed25519; do
    f="/etc/dropbear/dropbear_${t}_host_key"
    [ -f "$f" ] || dropbearkey -t "$t" -f "$f" 2>/dev/null
done

# SSH daemon: -R generate keys if missing, -E log to stderr
/usr/sbin/dropbear -R -E -p 22

# keep PID 1 alive; a console shell is handy for debugging via ttyS0
exec /bin/sh
