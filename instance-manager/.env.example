# Copy to .env (gitignored). Loaded at startup and by systemd. Real env
# vars take precedence. Kernel must match the one the pool-manager uses.

KERNEL_PATH=/var/lib/foxplay/vmlinux.bin
INSTANCES_DIR=/var/lib/foxplay/instances
BASE_IMAGES_DIR=/var/lib/foxplay/base

# FIRECRACKER_BIN=firecracker
# LISTEN_ADDR=:7000

# usage sampling → metrics service
# METRICS_URL=http://localhost:7070
# SAMPLE_INTERVAL_SEC=30

# host networking (defaults are fine for a single droplet)
# BRIDGE=fcbr0
# GATEWAY_IP=172.16.0.1
# SUBNET=172.16.0.0/24
# NETMASK=255.255.255.0
# PREFIX_LEN=24
