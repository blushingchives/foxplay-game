# Copy to .env (gitignored) and adjust. Loaded from the working directory at
# startup (and by systemd via EnvironmentFile); real env vars take precedence.
# Kernel/base rootfs must match the pool-manager's — snapshots are created
# here and restored there.

KERNEL_PATH=/var/lib/foxplay/vmlinux.bin
BASE_ROOTFS=/var/lib/foxplay/node22.ext4
FUNCTIONS_DIR=/var/lib/foxplay/functions

# FIRECRACKER_BIN=firecracker
# LISTEN_ADDR=:9090
# METRICS_URL=http://localhost:7070
