# Copy to .env (gitignored) and fill in. Loaded from the working directory
# at startup; real environment variables take precedence.

# Postgres connection string. Without it the service runs in degraded mode:
# /health reports "not configured" and all other endpoints return 503.
# lib/pq defaults to sslmode=require — append ?sslmode=disable for a local
# Postgres without TLS.
DATABASE_URL=postgres://user:password@localhost:5432/foxplay

# Address to listen on (default :7070)
# LISTEN_ADDR=:7070
